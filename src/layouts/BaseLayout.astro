---
import '../styles/global.css';
import '../styles/knowledge-book.css';
import '../styles/system-design.css';
import '../styles/diagram-zoom.css';
import { withBase as path } from '../lib/url';
const { title = 'AI Infrastructure Learning OS', description = 'A personal learning system for infrastructure engineering and AIOps.' } = Astro.props;
const nav = [['/','Dashboard'], ['/skills','Skill Map'], ['/system-design','System Design'], ['/coding-interviews','Coding Interviews'], ['/book','Knowledge Book'], ['/labs','Labs'], ['/projects','Projects'], ['/inbox','Inbox'], ['/news','News']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="brand" href={path('/')}>AI Infrastructure<span>Learning OS</span></a><nav aria-label="Primary">{nav.map(([href, label]) => <a href={path(href)}>{label}</a>)}</nav></header><main id="main" class="page"><slot /></main><footer class="site-footer">Git-backed personal learning system · Markdown is the source of truth.</footer>
<script>
  import { adjustDiagramZoom, formatDiagramZoom, type DiagramZoomAction } from '../lib/diagramZoom';

  function makeButton(label: string, accessibleLabel: string, action: () => void) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'diagram-control';
    button.textContent = label;
    button.setAttribute('aria-label', accessibleLabel);
    button.title = accessibleLabel;
    button.addEventListener('click', action);
    return button;
  }

  function createZoomToolbar(viewport: HTMLElement) {
    let scale = 1;
    const toolbar = document.createElement('div');
    toolbar.className = 'diagram-toolbar';
    toolbar.setAttribute('role', 'toolbar');
    toolbar.setAttribute('aria-label', 'Diagram zoom controls');

    const status = document.createElement('output');
    status.className = 'diagram-zoom-status';
    status.setAttribute('aria-live', 'polite');

    const updateZoom = (action: DiagramZoomAction) => {
      scale = adjustDiagramZoom(scale, action);
      viewport.style.setProperty('--diagram-zoom', String(scale));
      status.textContent = formatDiagramZoom(scale);
      zoomOut.disabled = adjustDiagramZoom(scale, 'out') === scale;
      zoomIn.disabled = adjustDiagramZoom(scale, 'in') === scale;
    };

    const zoomOut = makeButton('−', 'Zoom out diagram', () => updateZoom('out'));
    const reset = makeButton('Fit', 'Reset diagram to fit width', () => updateZoom('reset'));
    const zoomIn = makeButton('+', 'Zoom in diagram', () => updateZoom('in'));
    toolbar.append(zoomOut, reset, zoomIn, status);
    updateZoom('reset');
    return toolbar;
  }

  function openLargeDiagram(sourceViewport: HTMLElement, opener: HTMLButtonElement) {
    const diagram = sourceViewport.querySelector('svg');
    if (!diagram) return;

    const title = diagram.querySelector('title')?.textContent?.trim() || 'Architecture diagram';
    const dialog = document.createElement('dialog');
    dialog.className = 'diagram-dialog';
    dialog.setAttribute('aria-label', `${title} enlarged view`);

    const shell = document.createElement('div');
    shell.className = 'diagram-dialog-shell';
    const viewport = document.createElement('div');
    viewport.className = 'diagram-viewport diagram-dialog-viewport';
    viewport.tabIndex = 0;
    viewport.setAttribute('aria-label', `${title}. Scroll to explore the zoomed diagram.`);
    viewport.append(diagram);

    const toolbar = createZoomToolbar(viewport);
    toolbar.classList.add('diagram-dialog-toolbar');
    const close = makeButton('Close', 'Close enlarged diagram', () => dialog.close());
    close.classList.add('diagram-close');
    toolbar.append(close);
    shell.append(toolbar, viewport);
    dialog.append(shell);
    document.body.append(dialog);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      sourceViewport.append(diagram);
      dialog.remove();
      opener.focus();
    }, { once: true });
    dialog.showModal();
    viewport.focus();
  }

  const blocks = document.querySelectorAll('pre[data-language="mermaid"] > code');
  if (blocks.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'strict' });
    let i = 0;
    for (const code of blocks) {
      const source = code.textContent ?? '';
      const pre = code.parentElement;
      if (!pre) continue;
      try {
        const { svg } = await mermaid.render(`mermaid-${i++}`, source);
        const container = document.createElement('div');
        container.className = 'mermaid-diagram';
        const viewport = document.createElement('div');
        viewport.className = 'diagram-viewport';
        viewport.tabIndex = 0;
        viewport.setAttribute('aria-label', 'Diagram canvas. Scroll to explore when zoomed.');
        viewport.innerHTML = svg;
        const toolbar = createZoomToolbar(viewport);
        const expand = makeButton('Open large', 'Open diagram in a large viewer', () => openLargeDiagram(viewport, expand));
        expand.classList.add('diagram-expand');
        toolbar.append(expand);
        container.append(toolbar, viewport);
        pre.replaceWith(container);
      } catch (err) {
        console.error('Mermaid render failed', err);
      }
    }
  }
</script>
</body></html>
