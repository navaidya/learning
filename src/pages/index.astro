---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookNoteCard from '../components/book/BookNoteCard.astro';
import TopicHubCard from '../components/book/TopicHubCard.astro';
import { getKnowledgeDashboardModel } from '../lib/content';

const model = await getKnowledgeDashboardModel();
---
<BaseLayout title="Knowledge Book" description="A personal knowledge book for infrastructure engineering and AIOps.">
  <p class="eyebrow">Personal knowledge book</p>
  <h1>Knowledge Book</h1>
  <p class="lede">A quick, durable map of notes on infrastructure engineering, operations, and AIOps.</p>

  <section class="section-heading" aria-labelledby="start-here-title">
    <h2 id="start-here-title">Start Here</h2>
    <div class="grid note-grid">{model.startHere.map((entry) => <BookNoteCard entry={entry} />)}</div>
  </section>

  <section class="section-heading" aria-labelledby="topics-title">
    <h2 id="topics-title">Explore by topic</h2>
    <div class="grid topic-grid">{model.featuredHubs.map((hub) => <TopicHubCard hub={hub} />)}</div>
  </section>

  <section class="section-heading" aria-labelledby="recent-title">
    <h2 id="recent-title">Recently added</h2>
    <div class="grid note-grid">{model.recentlyAdded.map((entry) => <BookNoteCard entry={entry} />)}</div>
  </section>
</BaseLayout>
