---
import { getCollection, render } from 'astro:content';
import SystemDesignLayout from '../../layouts/SystemDesignLayout.astro';
import { withBase } from '../../lib/url';
export async function getStaticPaths() {
  const [entries, deployments] = await Promise.all([
    getCollection('system-design').then((items) => items.sort((a, b) => a.data.order - b.data.order)),
    getCollection('system-design-deployments'),
  ]);
  const deploymentIds = new Set(deployments.map((deployment) => deployment.data.systemDesign));
  return entries.map((entry, index) => ({ params: { slug: entry.id }, props: { entry, entries, index, hasDeployment: deploymentIds.has(entry.id) } }));
}
const { entry, entries, index, hasDeployment } = Astro.props;
const { Content } = await render(entry);
const previous = entries[index - 1]; const next = entries[index + 1];
---
<SystemDesignLayout {...entry.data} deploymentHref={hasDeployment ? withBase(`/system-design/${entry.id}/deployment`) : undefined}>
  {entries.map((item) => <a slot="sidebar" class:list={{ active: item.id === entry.id }} aria-current={item.id === entry.id ? 'page' : undefined} href={withBase(`/system-design/${item.id}`)}>{item.data.title}</a>)}
  <Content />
  {previous && <a slot="pagination" href={withBase(`/system-design/${previous.id}`)}>← {previous.data.title}</a>}
  {next && <a slot="pagination" href={withBase(`/system-design/${next.id}`)}>{next.data.title} →</a>}
</SystemDesignLayout>
