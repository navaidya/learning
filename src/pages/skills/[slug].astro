---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceList from '../../components/skills/ResourceList.astro';
import { domains } from '../../lib/domains';
import { getDomainResources } from '../../lib/resources';
import { withBase } from '../../lib/url';
export function getStaticPaths() { return domains.map(domain => ({ params: { slug: domain.slug }, props: { domain } })); }
const { domain } = Astro.props;
const curated = getDomainResources(domain.slug);
---
<BaseLayout title={`${domain.name} resources`}>
  <a href={withBase('/ai-watch')}>← AI Watch</a>
  <h1>{domain.name} resources</h1>
  {curated && <><p class="lede">{curated.summary}</p><ResourceList resources={curated.resources} /></>}
</BaseLayout>
