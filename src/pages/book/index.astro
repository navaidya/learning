---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookNoteCard from '../../components/book/BookNoteCard.astro';
import TopicHubCard from '../../components/book/TopicHubCard.astro';
import { getBookIndexModel } from '../../lib/content';

const model = await getBookIndexModel();
---
<BaseLayout title="Knowledge Book">
  <h1>Knowledge Book</h1>
  <p class="lede">Browse Markdown-first notes by the subjects they connect to.</p>

  <section aria-labelledby="topic-directory-title">
    <h2 id="topic-directory-title">Topics</h2>
    <div class="grid topic-grid">{model.hubs.map((hub) => <TopicHubCard hub={hub} />)}</div>
  </section>

  <section class="section-heading" aria-labelledby="all-notes-title">
    <h2 id="all-notes-title">All notes</h2>
    <div class="grid note-grid">{model.entries.map((entry) => <BookNoteCard entry={entry} />)}</div>
  </section>
</BaseLayout>
