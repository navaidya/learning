---
import type { NewsItem } from '../../lib/news/types';
import { withBase } from '../../lib/url';

const { items } = Astro.props as { items: NewsItem[] };
---

<section class="panel">
  <h2>Engineering Radar</h2>
  {items.length ? (
    <ul class="list">
      {items.map((item) => (
        <li>
          <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <span class="visually-hidden">(opens {item.source}, external)</span></a>
          <small>{item.source} · {new Date(item.publishedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</small>
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">No radar items yet. Run the collector to populate the Engineering Radar.</p>
  )}
  <a href={withBase('/news')}>View full Radar →</a>
</section>
