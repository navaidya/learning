---
import ProgressBar from '../common/ProgressBar.astro';
import { withBase } from '../../lib/url';
const { domain } = Astro.props;
---
<a class="domain-card" href={withBase(`/skills/${domain.slug}`)}><div class="split"><h3>{domain.name}</h3><strong>{domain.progress}%</strong></div><ProgressBar value={domain.progress} label={`${domain.name} progress`} /><small>{domain.topics.length} tracked topic{domain.topics.length === 1 ? '' : 's'}</small></a>
